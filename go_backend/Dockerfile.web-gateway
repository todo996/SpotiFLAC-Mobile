FROM golang:1.26.6-bookworm AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=1 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/spotiflac-web-gateway ./cmd/web-gateway

FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 10001 --create-home --home-dir /app spotiflac \
    && mkdir -p /app/extensions /app/data \
    && chown -R spotiflac:spotiflac /app

COPY --from=build /out/spotiflac-web-gateway /usr/local/bin/spotiflac-web-gateway

USER spotiflac
WORKDIR /app

ENV SPOTIFLAC_GATEWAY_ADDR=:8787 \
    SPOTIFLAC_EXTENSIONS_DIR=/app/extensions \
    SPOTIFLAC_DATA_DIR=/app/data

EXPOSE 8787

ENTRYPOINT ["/usr/local/bin/spotiflac-web-gateway"]
